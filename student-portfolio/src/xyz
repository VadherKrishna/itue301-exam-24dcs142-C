.container{
    width:70%;
    margin:auto;
    text-align:center;
    font-family:Arial, Helvetica, sans-serif;
}

header,
section,
footer,
nav{
    border:1px solid gray;
    margin:15px;
    padding:15px;
    border-radius:8px;
}

nav{
    display:flex;
    justify-content:center;
    gap:20px;
}

nav a{
    text-decoration:none;
    color:blue;
    font-weight:bold;
}

nav a.active{
    color:red;
}

ul {
  text-align: left;
  display: inline-block;
}

li {
  margin-bottom: 15px;
}

a {
  color: blue;
}

input{
    padding:8px;
    margin:10px;
}

button{
    padding:8px 15px;
    cursor:pointer;
}